    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.7",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
