<div class="pipe-game" data-pipeline>
  <p class="pipe-help">Rotate the pipes (click or tap) so the pipeline runs from <b>commit</b> to <b>deploy</b> before the timer ends.</p>
  <div class="pipe-grid" data-grid></div>
  <div class="pipe-bar">
    <span data-level>Level 1/3</span>
    <span data-time>Time: --</span>
    <button type="button" data-new>New game</button>
  </div>
  <p class="pipe-msg" data-msg role="status" aria-live="polite">Waiting for first commit…</p>
</div>
<script>
  import { initPipeline } from "../scripts/pipeline-ui";

  for (const el of document.querySelectorAll<HTMLElement>("[data-pipeline]")) initPipeline(el);
</script>
