---
import "../styles/os.css";
import { getCollection, render } from "astro:content";
import wallpaper from "../assets/wallpaper/animals.svg?raw";
import FreeCell from "../components/FreeCell.astro";
import Globe from "../components/Globe.astro";
import Hearts from "../components/Hearts.astro";
import Helper from "../components/Helper.astro";
import Icon from "../components/Icon.astro";
import Icons from "../components/Icons.astro";
import Internet from "../components/Internet.astro";
import Pinball from "../components/Pinball.astro";
import Pipeline from "../components/Pipeline.astro";
import Solitaire from "../components/Solitaire.astro";
import Spider from "../components/Spider.astro";
import Sweeper from "../components/Sweeper.astro";
import Window from "../components/Window.astro";

const items = (await getCollection("items")).sort((a, b) => a.data.order - b.data.order);
const inPlace = (p: string) => items.filter((i) => i.data.parent === p);
const windows = await Promise.all(
  items.filter((i) => !i.data.opens).map(async (i) => ({ ...i, Content: (await render(i)).Content })),
);
const desktop = inPlace("desktop");
const users = [
  { role: "recruiter", name: "IT recruiter", hint: "Resume and CV download", icon: "briefcase" },
  { role: "nonprofit", name: "Nonprofit cooperation", hint: "Invisible School and Rotary", icon: "hands" },
  { role: "guest", name: "Other, guest", hint: "Just looking around", icon: "guest" },
];
const description =
  "Kristóf Kovács: Developer Experience Engineer, founder of the Invisible School, Rotarian. A personal site that boots like it's 2003.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KK · Kristóf Kovács</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="KK · Kristóf Kovács" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}profile.jpg`, Astro.site)} />
    <meta name="theme-color" content="#245edb" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Decide before first paint so the desktop never flashes before the boot and welcome screens.
      try {
        if (!sessionStorage.getItem("kk-booted") && !location.hash) {
          const d = document.documentElement.dataset;
          d.welcome = "1";
          if (!matchMedia("(prefers-reduced-motion: reduce)").matches) d.boot = "1";
        }
      } catch {}
    </script>
  </head>
  <body>
    <Icons />

    <div id="boot" class="boot">
      <div class="boot-logo">
        <span class="wordart" role="img" aria-label="KristofK">{[..."KristofK"].map((c, i) => <span aria-hidden="true" style={`--i:${i}`}>{c}</span>)}</span>
        <span class="boot-ed">Personal Edition</span>
      </div>
      <div class="boot-bar" role="progressbar" aria-label="Loading"><i></i><i></i><i></i></div>
      <p class="boot-copy">© 2026 Kristóf Kovács</p>
      <button type="button" id="boot-skip" class="boot-skip">Skip ▸</button>
    </div>

    <div id="welcome" class="welcome">
      <div class="welcome-main">
        <div class="welcome-left">
          <p class="welcome-brand">KristofK</p>
          <p>To begin, click your user name</p>
        </div>
        <ul class="welcome-users" aria-label="Choose a user">
          {users.map((u) => (
            <li>
              <button type="button" data-role={u.role}>
                <span class="welcome-pic"><Icon name={u.icon} /></span>
                <span><b>{u.name}</b><small>{u.hint}</small></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="welcome-bottom">
        <button type="button" data-turn-off>⏻ Turn off KristofK</button>
        <span>Your choice only decides which window opens first.</span>
      </div>
    </div>

    <div class="wallpaper" aria-hidden="true" set:html={wallpaper}></div>
    <div class="weather" aria-hidden="true">
      <svg class="bolt" viewBox="0 0 60 200"><path d="M36 0 24 54l14 4-20 58 14 4-22 80M24 54 8 84m30 32 12 26" /></svg>
    </div>
    <main id="desktop" class="desktop">
      <h1 class="visually-hidden">Kristóf Kovács, personal site</h1>
      <ul class="icons">
        {desktop.map((i) => (
          <li><button type="button" class="icon" data-open={i.data.opens ?? i.id}><Icon name={i.data.icon} /><span>{i.data.label ?? i.data.title}</span></button></li>
        ))}
      </ul>

      <p class="counter">Visitors <output id="counter">000000</output></p>

      {windows.map(({ id, data, body, Content }) => (
        <Window id={id} title={data.title} icon={data.icon} width={data.width}>
          {data.folder ? (
            <>
              {/* a folder's own Markdown, if any, shows as an info bar above its icons */}
              {body?.trim() && <div class="folder-note"><Content /></div>}
              <ul class="icons folder-view">
                {inPlace(data.folder).map((c) => (
                  <li><button type="button" class="icon" data-open={c.data.opens ?? c.id}><Icon name={c.data.icon} /><span>{c.data.label ?? c.data.title}</span></button></li>
                ))}
              </ul>
            </>
          ) : data.app === "pipeline" ? (
            <Pipeline />
          ) : data.app === "internet" ? (
            <Internet links={data.links} />
          ) : data.app === "sweeper" ? (
            <Sweeper />
          ) : data.app === "solitaire" ? (
            <Solitaire />
          ) : data.app === "freecell" ? (
            <FreeCell />
          ) : data.app === "spider" ? (
            <Spider />
          ) : data.app === "hearts" ? (
            <Hearts />
          ) : data.app === "pinball" ? (
            <Pinball />
          ) : data.app === "globe" ? (
            <Globe />
          ) : (
            <article class="doc"><Content /></article>
          )}
          {data.links.length > 0 && !data.app && (
            <nav class="links" aria-label="Links">
              {data.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
            </nav>
          )}
          {data.folder && (
            <div class="status-bar" slot="status"><p class="status-bar-field">{inPlace(data.folder).length} objects</p></div>
          )}
        </Window>
      ))}
      <Window id="cv" title="Kristof-Kovacs-CV.pdf - KK Reader" icon="resume" width={780}>
        <div class="pdf-viewer">
          <div class="pdf-bar">
            <span>📄 Kristof-Kovacs-CV.pdf</span>
            <a href="Kristof-Kovacs-CV.pdf" target="_blank" rel="noopener">Open in new tab ↗</a>
            <a class="button-link" href="Kristof-Kovacs-CV.pdf" download>💾 Download</a>
          </div>
          <!-- data is set on first open, so the PDF only loads when someone wants it -->
          <object class="pdf-frame" type="application/pdf" data-src="Kristof-Kovacs-CV.pdf#view=FitH" title="Kristóf Kovács, CV (PDF)">
            <p class="pdf-fallback">
              This browser can't show the PDF inside the page.<br />
              <a href="Kristof-Kovacs-CV.pdf" target="_blank" rel="noopener">Open the CV in a new tab</a>{" or "}
              <a href="Kristof-Kovacs-CV.pdf" download>download it</a>.
            </p>
          </object>
        </div>
      </Window>
    </main>

    <Helper />

    <footer class="taskbar">
      <button type="button" class="start" popovertarget="start-menu"><Icon name="kk" size={28} /> start</button>
      <div id="tasks" class="tasks" role="toolbar" aria-label="Open windows"></div>
      <div class="tray">
        <button type="button" id="racka-call" class="tray-racka" aria-label="Racka, your guide: call him or open his menu" aria-keyshortcuts="R" title="Racka (press R)"><Icon name="racka" size={26} /></button>
        <button type="button" id="weather" class="tray-weather" data-open="weather" hidden></button>
        <button type="button" id="clock" class="clock" popovertarget="calendar">--:--</button>
      </div>
    </footer>

    <div id="start-menu" class="start-menu" popover>
      <header><img src="profile.jpg" alt="" width="40" height="40" /><b>Kristóf Kovács</b></header>
      <ul>
        {desktop.map((i) => (
          <li><button type="button" data-open={i.data.opens ?? i.id}><Icon name={i.data.icon} size={24} />{i.data.label ?? i.data.title}</button></li>
        ))}
        <li class="sep"><button type="button" data-open="cv"><Icon name="resume" size={24} />My CV (PDF)</button></li>
        <li><a href="https://www.linkedin.com/in/kkristof/" target="_blank" rel="noopener"><Icon name="contacts" size={24} />LinkedIn</a></li>
      </ul>
      <footer><button type="button" id="logoff-btn">🔑 Log off</button><button type="button" id="shutdown-btn">⏻ Shut down…</button></footer>
    </div>

    <div role="region" aria-label="Notifications">
      <div id="calendar" class="calendar" popover role="dialog" aria-labelledby="cal-title">
      <div class="title-bar">
        <div class="title-bar-text" id="cal-title">Date and Time</div>
        <div class="title-bar-controls"><button type="button" aria-label="Close" popovertarget="calendar" popovertargetaction="hide"></button></div>
      </div>
      <div class="cal-body">
        <div>
          <div class="cal-nav">
            <button type="button" data-cal="-1" aria-label="Previous month">◀</button>
            <b data-cal-title aria-live="polite"></b>
            <button type="button" data-cal="1" aria-label="Next month">▶</button>
          </div>
          <table class="cal-grid">
            <thead><tr>{["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"].map((d) => <th scope="col">{d}</th>)}</tr></thead>
            <tbody data-cal-days></tbody>
          </table>
        </div>
        <div class="cal-clock">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="46" fill="#fff" stroke="#7f9db9" stroke-width="3" />
            {Array.from({ length: 12 }, (_, i) => <line x1="50" y1="8" x2="50" y2={i % 3 ? 13 : 17} stroke="#333" stroke-width={i % 3 ? 2 : 4} transform={`rotate(${i * 30} 50 50)`} />)}
            <line data-hand="h" x1="50" y1="50" x2="50" y2="26" stroke="#1d2b4f" stroke-width="5" stroke-linecap="round" />
            <line data-hand="m" x1="50" y1="50" x2="50" y2="15" stroke="#1d2b4f" stroke-width="3" stroke-linecap="round" />
            <line data-hand="s" x1="50" y1="58" x2="50" y2="12" stroke="#d62a1a" stroke-width="1.5" />
            <circle cx="50" cy="50" r="3" fill="#1d2b4f" />
          </svg>
          <p data-cal-time></p>
        </div>
      </div>
    </div>

    <div id="balloon" class="balloon" popover="manual">
        <button type="button" class="balloon-x" popovertarget="balloon" popovertargetaction="hide" aria-label="Close notification">×</button>
        <b data-title></b>
        <button type="button" class="balloon-text" data-text></button>
      </div>
      <p class="visually-hidden">Screen reader announcements</p>
      <div id="announcer" class="visually-hidden" aria-live="polite"></div>
    </div>

    <!-- right-click on the empty desktop, like XP -->
    <div id="desktop-menu" class="context-menu" popover role="menu">
      <button type="button" role="menuitem" id="arrange-btn">Arrange icons</button>
      <button type="button" role="menuitem" id="wallpaper-reset" hidden>Back to the Hortobágy wallpaper</button>
    </div>

    <div id="shutdown" class="shutdown" hidden><p>It is now safe to turn off your computer.</p><button type="button">Restart</button></div>

    <script>
      import "../scripts/desktop";
      import "../scripts/weather";
    </script>
  </body>
</html>
